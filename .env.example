# Baza (PostgreSQL). Prisma używa adaptera @prisma/adapter-pg.
DATABASE_URL="postgresql://user:haslo@host:5432/lwnieruchomosci"

# Publiczny adres instancji — używany w kanonicznych URL-ach i sitemapie.
APP_URL="https://staging.lw.nieruchomosci.pl"

# Wymagane przez adapter-node za proxy (nginx). Bez tego SvelteKit odrzuca
# wszystkie POST-y jako cross-site (403). Musi być adresem, pod którym
# użytkownik widzi stronę — NIE adresem IP.
ORIGIN="https://staging.lw.nieruchomosci.pl"

# Klucz HMAC do podpisu ciasteczka sesji panelu. Bez niego podpis leci
# z DATABASE_URL — działa, ale zmiana hasła do bazy wylogowuje wszystkich.
AUTH_SECRET="dowolny-dlugi-losowy-ciag"

PORT=3011

# Panel przyjmuje zdjęcia prosto z telefonu (kilka MB na sztukę), a adapter-node
# domyślnie ucina ciało żądania na 512 kB i zwraca 413 — upload zdjęć wtedy nie
# działa. Wartość trzymamy zgodną z client_max_body_size w nginx.
BODY_SIZE_LIMIT=25M

# ── Powiadomienia e-mail o zgłoszeniach ─────────────────────────────────────
# Bez tych zmiennych zgłoszenia z formularzy trafiają WYŁĄCZNIE do panelu
# (/panel/zgloszenia) — nikt nie dostanie maila. Skrzynka biuro@ stoi na Zoho,
# więc SMTP_PASS to hasło aplikacji z Zoho (Ustawienia → Bezpieczeństwo →
# Hasła aplikacji), NIE hasło do logowania.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=biuro@lw.nieruchomosci.pl
SMTP_PASS=haslo-aplikacji-z-zoho
# Nadawca musi być adresem z tej samej skrzynki, inaczej Zoho odrzuci wysyłkę.
MAIL_FROM=biuro@lw.nieruchomosci.pl
# Dokąd lecą powiadomienia (można podać kilka po przecinku).
MAIL_TO=biuro@lw.nieruchomosci.pl
